PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-32-byte-hex-string-for-production
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartexpenses_db?schema=public
# Optional MongoDB Atlas connection string to view database in VS Code MongoDB extension:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smartexpenses?retryWrites=true&w=majority
